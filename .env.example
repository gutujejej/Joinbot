PORT=3000
# Public https address of this service (Railway domain). Needed for webhooks and the mini app.
PUBLIC_URL=https://your-joinbot.up.railway.app
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_here
# Optional: a "factory" bot. Anyone who sends it a BotFather token gets their own system.
FACTORY_BOT_TOKEN=
# Optional: Telegram ids (comma separated) that are admin in every system.
SUPER_ADMIN_IDS=
# Ethiopia is UTC+3
TZ_OFFSET_HOURS=3
